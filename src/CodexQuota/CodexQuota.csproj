<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>CodexQuota.Program</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodexQuota</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/codex-quota.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CodexQuota.Core/CodexQuota.Core.csproj" /></ItemGroup>
</Project>
